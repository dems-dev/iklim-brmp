PORT=5000

# --- Database ---
# Pengembangan lokal:
MONGO_URI=mongodb://localhost:27017/brmp
#
# MongoDB Atlas (produksi). Ambil dari Atlas → Connect → Drivers, lalu:
#   - ganti <db_password> dengan password user database
#   - sisipkan nama database (brmp) sebelum tanda tanya
#   - URL-encode password bila memuat @ : / ? # % (mis. @ menjadi %40)
# MONGO_URI=mongodb+srv://brmp_app:<password>@cluster0.xxxxx.mongodb.net/brmp?retryWrites=true&w=majority

# Wajib diganti. Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
JWT_EXPIRES_IN=8h
# Daftar origin frontend, pisahkan dengan koma
CORS_ORIGIN=http://localhost:6969

# --- Produksi ---
# WAJIB diset saat dipublikasikan. Tanpa ini, origin localhost dan LAN
# tetap diizinkan otomatis oleh aturan CORS mode pengembangan.
# NODE_ENV=production

# Isi bila aplikasi berada di belakang proxy (Nginx, Vercel, Railway).
# Tanpa ini pembatas laju melihat semua pengunjung sebagai satu IP.
# Angkanya = jumlah lapisan proxy.
# TRUST_PROXY=1

# --- Migrasi (hanya dipakai scripts/migrasiKeAtlas.js, tidak dibaca aplikasi) ---
# MONGO_URI_ASAL=mongodb://localhost:27017/brmp
# MONGO_URI_TUJUAN=mongodb+srv://...
