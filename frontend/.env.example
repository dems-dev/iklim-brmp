# Hanya diperlukan bila backend berada di DOMAIN LAIN dari frontend.
# Saat di-deploy ke Vercel (frontend + API satu domain), biarkan kosong:
# aplikasi otomatis memakai jalur relatif /api.
VITE_API_URL=http://localhost:5000/api

# Akun demo yang ditampilkan di halaman login (opsional). Bila keduanya diisi,
# halaman login menampilkan kredensial ini beserta tombol "Masuk sebagai demo".
# Nilainya ikut tertanam di bundel JavaScript, jadi pakai akun ber-role user.
# VITE_DEMO_USERNAME=demo
# VITE_DEMO_PASSWORD=
